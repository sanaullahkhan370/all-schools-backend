PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/schools
JWT_SECRET=replace_with_a_long_random_secret_for_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Multi-school database mapping
CITY_SCHOOL_DB=schools
SMART_SCHOOL_CHINA_SCHEME_DB=smart_school_china_scheme
JINNAH_SCHOOL_DB=jinnah_school_harnoli
SHINING_STAR_SCHOOL_DB=shining_star_school_piplan
SCHOOL_SIMPLE_SAMPLE_DB=school_simple_sample
## Optional: purane Map_Bustracking_Backend ka MongoDB URI.
## Agar set na ho to bus tracker bhi MONGO_URI use karega.
BUS_TRACKING_MONGO_URI=
